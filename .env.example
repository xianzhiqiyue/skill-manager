# ─── Skills / 阿里云 OSS ───────────────────────────────────────
# 建议：Core 同地域 ECS 优先走 internal endpoint；外部下载走 public CNAME。

# 用途：是否启用 Skill 包上传、存储与分发的 OSS 能力。
# 获取：部署开关，由运维决定；启用 OSS 时填 true，否则填 false。
SOULSTORE_SKILL_OSS_ENABLED=false

# 用途：Skill 包 OSS 所在地域。
# 获取：阿里云控制台 -> 对象存储 OSS -> Bucket 概览 -> 地域。
SOULSTORE_SKILL_OSS_REGION=

# 用途：存放已发布 Skill 包的正式 Bucket 名称。
# 获取：阿里云控制台 -> 对象存储 OSS -> Bucket 列表；没有就新建。
SOULSTORE_SKILL_OSS_BUCKET_RELEASE=

# 用途：存放待扫描、隔离或未正式发布 Skill 包的 Bucket 名称。
# 获取：阿里云控制台 -> 对象存储 OSS -> Bucket 列表；建议单独新建隔离 Bucket。
SOULSTORE_SKILL_OSS_BUCKET_QUARANTINE=

# 用途：服务端上传、回填时优先访问的 OSS 内网 Endpoint。
# 获取：阿里云控制台 -> 对象存储 OSS -> Bucket 概览/Endpoint 信息；同地域 ECS 场景优先填内网地址。
SOULSTORE_SKILL_OSS_INTERNAL_ENDPOINT=

# 用途：对外下载使用的公网自定义域名或 CNAME 根地址。
# 获取：先在 OSS 绑定自定义域名，再到 DNS / CDN / OSS 控制台确认最终生效的公网域名。
SOULSTORE_SKILL_OSS_PUBLIC_CNAME_ENDPOINT=

# 用途：是否默认优先使用内网 Endpoint 访问 OSS。
# 获取：部署策略；同地域 ECS / VPC 场景一般填 true，本地调试或跨公网访问一般填 false。
SOULSTORE_SKILL_OSS_USE_INTERNAL_ENDPOINT=true

# 用途：访问 OSS 的 AccessKey ID。
# 获取：阿里云 RAM 用户 -> AccessKey 管理；建议使用最小权限子账号，不要直接用主账号。
SOULSTORE_SKILL_OSS_ACCESS_KEY_ID=

# 用途：访问 OSS 的 AccessKey Secret。
# 获取：同上；创建或轮换 AccessKey 时获取，并放入密钥管理系统后再填入环境变量。
SOULSTORE_SKILL_OSS_ACCESS_KEY_SECRET=

# 用途：分片上传时每片的大小（MB）。
# 获取：应用调优参数，无需外部申请；默认 16，只有大文件或弱网络场景再调整。
SOULSTORE_SKILL_OSS_UPLOAD_PART_SIZE_MB=16

# 用途：分片上传并发数。
# 获取：应用调优参数；根据服务器带宽、CPU 和 OSS 请求配额调优，默认 4。
SOULSTORE_SKILL_OSS_UPLOAD_CONCURRENCY=4

# ─── Client Release Artifact / 阿里云 OSS ───────────────────────
# 默认使用 OSS 存储客户端下载包；留空时可回退复用 Skills 的 OSS 配置。

# 用途：CLI 发布产物的存储后端，支持 oss / local。
# 获取：部署策略；接入 OSS 时填 oss，仅做本地落盘时填 local。
SOULSTORE_CLIENT_RELEASE_STORAGE_BACKEND=oss

# 用途：当存储后端为 local 时使用的本地目录；使用 oss 时可留空。
# 获取：运维在服务器上规划的目录路径，例如 /opt/soulstore/releases。
SOULSTORE_CLIENT_RELEASE_STORAGE_DIR=

# 用途：单次上传允许的最大文件大小（字节）。
# 获取：应用限制参数；根据 CLI 发布包体积上限与服务器容量策略确定。
SOULSTORE_CLIENT_RELEASE_MAX_UPLOAD_BYTES=8589934592

# 用途：下载链接签名有效期（秒）。
# 获取：应用安全策略参数；根据“下载体验 vs. 链接暴露窗口”权衡后确定。
SOULSTORE_CLIENT_RELEASE_DOWNLOAD_PRESIGN_TTL_SECONDS=600

# 用途：CLI 发布产物所在 OSS 地域。
# 获取：阿里云控制台 -> 对象存储 OSS -> Bucket 概览 -> 地域；若复用 Skills Bucket，应保持一致。
SOULSTORE_CLIENT_RELEASE_OSS_REGION=

# 用途：存放 CLI 发布产物的正式 Bucket 名称。
# 获取：阿里云控制台 -> 对象存储 OSS -> Bucket 列表；可单独建 Bucket，也可按团队规范复用现有 Bucket。
SOULSTORE_CLIENT_RELEASE_OSS_BUCKET_RELEASE=

# 用途：服务端上传 CLI 发布产物时使用的 OSS 内网 Endpoint。
# 获取：阿里云控制台 -> 对象存储 OSS -> Bucket 概览/Endpoint 信息；同地域 ECS 优先填内网地址。
SOULSTORE_CLIENT_RELEASE_OSS_INTERNAL_ENDPOINT=

# 用途：客户端下载时使用的公网自定义域名或 CNAME 根地址。
# 获取：在 OSS 绑定自定义域名后，从 DNS / CDN / OSS 控制台确认最终生效域名。
SOULSTORE_CLIENT_RELEASE_OSS_PUBLIC_CNAME_ENDPOINT=

# 用途：CLI 发布产物上传时是否优先走内网 Endpoint。
# 获取：部署策略；同地域 ECS / VPC 场景一般填 true，本地调试或跨公网访问一般填 false。
SOULSTORE_CLIENT_RELEASE_OSS_USE_INTERNAL_ENDPOINT=true

# 用途：CLI 发布产物所在 OSS 的 AccessKey ID。
# 获取：阿里云 RAM 用户 -> AccessKey 管理；可与 Skills OSS 共用一组最小权限凭证，也可单独分配。
SOULSTORE_CLIENT_RELEASE_OSS_ACCESS_KEY_ID=

# 用途：CLI 发布产物所在 OSS 的 AccessKey Secret。
# 获取：同上；建议通过密钥管理系统下发，不要把真实值提交到仓库。
SOULSTORE_CLIENT_RELEASE_OSS_ACCESS_KEY_SECRET=

# 用途：CLI 发布产物分片上传时每片大小（MB）。
# 获取：应用调优参数；默认 16，只有在大文件上传效率不理想时再调整。
SOULSTORE_CLIENT_RELEASE_OSS_UPLOAD_PART_SIZE_MB=16

# 用途：CLI 发布产物分片上传并发数。
# 获取：应用调优参数；根据服务器带宽、CPU 和 OSS 请求配额调优，默认 4。
SOULSTORE_CLIENT_RELEASE_OSS_UPLOAD_CONCURRENCY=4
